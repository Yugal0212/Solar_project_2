<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Do not rewrite requests for the Next.js static assets folder
  RewriteRule ^_next/ - [L]

  # 2. If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Serve Next.js custom 404 page for any missing files
  ErrorDocument 404 /404.html
</IfModule>

# Ensure proper caching for static assets (optional but recommended)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
